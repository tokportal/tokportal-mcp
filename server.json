{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.tokportal/mcp",
  "title": "TokPortal",
  "description": "Managed TikTok/Instagram/YouTube accounts + video posting at scale, operated by human managers.",
  "version": "1.13.0",
  "websiteUrl": "https://developers.tokportal.com/mcp",
  "repository": {
    "url": "https://github.com/tokportal/tokportal-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.tokportal.com/api/ext/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "tokportal-mcp",
      "version": "1.13.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TOKPORTAL_API_KEY",
          "description": "TokPortal API key (sk_...) from https://app.tokportal.com/developer/api-keys",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}